POSTGRES_DB=ceh_sklad
POSTGRES_USER=ceh
CEH_ACCESS_TOKEN_MINUTES=720
CEH_HTTP_PORT=80
CEH_HTTPS_PORT=443

# Секреты не записываются в этот файл: здесь указываются только пути к файлам на сервере.
CEH_DB_PASSWORD_FILE=./secrets/db_password.txt
CEH_JWT_SECRET_FILE=./secrets/jwt_secret.txt
CEH_INTEGRATION_API_KEY_FILE=./secrets/integration_api_key.txt
CEH_REDIS_PASSWORD_FILE=./secrets/redis_password.txt

# Production Nginx ожидает готовую цепочку сертификата и закрытый ключ.
CEH_TLS_FULLCHAIN_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
CEH_TLS_PRIVKEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem
