{
    email {$ACME_EMAIL}
}

http://{$CEH_PUBLIC_HOST} {
    redir {$CEH_PUBLIC_ORIGIN}{uri} permanent
}

https://{$CEH_PUBLIC_HOST} {
    tls {
        issuer acme {
            profile shortlived
            disable_tlsalpn_challenge
        }
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; connect-src 'self' {$CEH_PUBLIC_WS_ORIGIN}; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    @backend path /api/* /health /health/*
    handle @backend {
        header Cache-Control "no-store"
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy admin-web:80
    }
}
