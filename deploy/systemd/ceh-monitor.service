[Unit]
Description=Проверка production Цех Склад
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ceh-sklad
EnvironmentFile=/opt/ceh-sklad/.env.production
EnvironmentFile=-/etc/ceh-sklad/monitor.env
Environment=CEH_MONITOR_CA_CERT=/etc/ceh-sklad/ceh-sklad-root-ca.crt
Environment=CEH_MONITOR_CONNECT_HOST=127.0.0.1
ExecStart=/usr/bin/python3 /opt/ceh-sklad/scripts/production_monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
