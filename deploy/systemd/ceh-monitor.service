[Unit]
Description=Проверка production Цех Склад
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ceh-sklad
EnvironmentFile=/opt/ceh-sklad/.env.production
EnvironmentFile=-/etc/ceh-sklad/monitor.env
ExecStart=/usr/bin/python3 /opt/ceh-sklad/scripts/production_monitor.py
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
